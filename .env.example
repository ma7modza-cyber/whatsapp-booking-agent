# --- DeepSeek (you already have this key) ---
DEEPSEEK_API_KEY=paste-your-deepseek-key-here
DEEPSEEK_MODEL=deepseek-v4-pro
DEEPSEEK_BASE_URL=https://api.deepseek.com

# --- Twilio WhatsApp Sandbox (the easy path - no Meta business account needed) ---
# From the Twilio Console home page (Account Info box):
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
# The sandbox number from the "Try out WhatsApp" page, with the whatsapp: prefix:
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886

# --- Meta WhatsApp Cloud API (only if you go back to the Meta setup later) ---
META_VERIFY_TOKEN=pick-any-random-word-you-like
META_ACCESS_TOKEN=
META_PHONE_NUMBER_ID=

PORT=5000

# Exact public origin used by Twilio, without /webhook (needed behind a proxy/tunnel)
PUBLIC_BASE_URL=
# Meta webhook request signing secret (required only when using Meta Cloud API)
META_APP_SECRET=
# Abuse controls
RATE_LIMIT_PER_MINUTE=30
MAX_WEBHOOK_BYTES=65536
